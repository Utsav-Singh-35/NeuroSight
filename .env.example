# ==========================================================
#  NeuraSight - repo-root environment file
# ==========================================================
# Copy to `.env` and fill in. This file holds values shared across the whole
# project. Service-local .env files (backend/express/.env, backend/fastapi/.env)
# override these on conflict.
#
# NEVER put real values in this file - it is committed. `.env` is gitignored.

# --- Shared infrastructure --------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/neurasight
FASTAPI_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Groq API ---------------------------------------------------------------
# Only needed to RE-AUTHOR the clinical narratives offline
# (backend/fastapi/scripts/author_narratives.py). The running application does
# NOT call any LLM: the 12 narratives in knowledge/narratives/ are pre-generated
# and served from disk behind a human-review gate. Leave empty to run the app.
#
# Free key: https://console.groq.com/keys
GROQ_API=

# Groq rotates its model lineup; `llama-3.3-70b-versatile` returned 404 on
# 2026-09-29. Check availability with:
#   python scripts/author_narratives.py --list-models
GROQ_MODEL=openai/gpt-oss-120b
