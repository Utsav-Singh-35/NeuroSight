# ==========================================================
#  NeuraSight - FastAPI ML service
# ==========================================================
# Copy to `backend/fastapi/.env`. Values here override the repo-root .env.
#
# IMPORTANT: every path below is RELATIVE and resolves against the process
# working directory, so uvicorn MUST be started from `backend/fastapi`.
# Starting it from the repo root breaks every weight path.

# --- Model locations --------------------------------------------------------
MODEL_PATH=../../models/BRAIN_MRI_EFFICIENTNET.pth
MODELS_DIR=../../models
CHEST_MODELS_DIR=../../chest
USE_ENSEMBLE=True

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Classes / explainability ----------------------------------------------
CLASS_LABELS=Glioma,Meningioma,No Tumor,Pituitary
GRADCAM_OPACITY=0.4
# Note: currently inert - JET is hardcoded in _overlay_heatmap.
GRADCAM_COLORMAP=jet

# --- Inference runtime ------------------------------------------------------
# Pin to CPU even when a GPU is present (useful for reproducible timing).
FORCE_CPU=False

# Comma-separated module ids whose weights load at startup. Modules left out
# are still served, just cached lazily on the first request (~15 s for brain).
PRELOAD_MODULES=brain_mri

# Hard upload cap at the FastAPI layer, so a direct call cannot bypass the
# Express gateway's limit.
MAX_UPLOAD_BYTES=10485760

# --- Input validation -------------------------------------------------------
# The quality gate rejects ~2% of valid in-distribution scans at the fitted
# 1st-percentile thresholds, so blocking is opt-in. When False the assessment
# is still computed and reported, just not enforced.
ENFORCE_QUALITY_GATE=False

# --- Calibration / conformal artefacts -------------------------------------
CALIBRATION_DIR=../../models/calibration

# Target miscoverage for conformal prediction sets. 0.01 => 99% target coverage.
# NOT the textbook 0.10: conformal sets collapse to singletons whenever
# 1-alpha < model accuracy, and at 97.71% accuracy anything above 0.0229 makes
# the layer vacuous. There is also a finite-sample floor at 0.0031 for
# n_calibration=320. Evidence: models/calibration/conformal.json -> alpha_sweep.
CONFORMAL_ALPHA=0.01
