# ==========================================================
#  NeuraSight - Express API gateway
# ==========================================================
# Copy to `backend/express/.env`. Values here override the repo-root .env.
# NEVER put real credentials in this file - it is committed.

PORT=5000

# Use a local MongoDB, or an Atlas SRV string. If you use Atlas, put the real
# URI in `.env` (gitignored), never here.
MONGODB_URI=mongodb://localhost:27017/neurasight

FASTAPI_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# 10 MB. Mirrors MAX_UPLOAD_BYTES on the FastAPI side.
MAX_FILE_SIZE=10485760

# The brain MRI ensemble runs 4 models on CPU and /api/scan issues the report
# and the Grad-CAM concurrently. At 30000 this silently timed out at ~30,297 ms
# and every brain scan lost its heatmap. Do not lower it without re-checking
# /api/scan latency for brain_mri.
FASTAPI_TIMEOUT=120000

HEALTH_CHECK_TIMEOUT=3000
